{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyberia",
  "version": "0.1.0",
  "identifier": "app.cyberia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Tus audios de la PC en el celular, por el Wi-Fi de casa.",
    "longDescription": "Cyberia publica una carpeta de audios de la PC para que la app del celular la descargue mientras carga y la reproduzca sin conexión.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    },
    "resources": [
      "resources/*"
    ],
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright © 2026 EloyRolda. Software libre bajo la licencia GPL 3.0 o posterior."
  }
}
